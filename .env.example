# ---------------------------------------------------------------------------
# Book Shop Management — environment configuration
# Copy this file to ".env" and adjust as needed. ".env" is git-ignored.
# ---------------------------------------------------------------------------

# Database connection (SQLAlchemy URL).
# Default (no setting): a zero-config SQLite file in the project root.
#   sqlite:///bookshop.db
#
# Production MySQL (matches docker-compose.yml):
#   DATABASE_URL=mysql+pymysql://bookshop:bookshop@localhost:3306/book_shop
#
# In-memory SQLite (used automatically by the test suite):
#   sqlite+pysqlite:///:memory:
# DATABASE_URL=sqlite:///bookshop.db

# Application metadata (used for window title and QSettings storage).
APP_NAME=Book Shop Management
ORG_NAME=BookShopOSS

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# UI preferences (also adjustable at runtime; persisted via QSettings).
# Theme: dark | light | system
BOOKSHOP_THEME=dark
# Font scale: small | medium | large
BOOKSHOP_FONT_SCALE=medium
# Reduce motion (disable animations) for accessibility: 0 | 1
BOOKSHOP_REDUCED_MOTION=0
